{
  "expo": {
    "name": "farimod",
    "slug": "farimod-2",
    "owner": "yeganeh0",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/main-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/main-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/favicon512.png",
        "backgroundColor": "#ffffff",
        "padding": "100px"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE"
      ],
      "edgeToEdgeEnabled": true,
      "package": "com.yeganeh0.farimod2"
    },
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "favicon": "./assets/main-icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "452922dd-854c-4587-9ee8-a4dc7075dccd"
      },
      "apiUrl": "http://89.42.208.49"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "networkSecurityConfig": "./network_security_config.xml"
          }
        }
      ]
    ]
  }
}
