{
  "expo": {
    "name": "farimod",
    "slug": "farimod-2",
    "owner": "yeganeh1",
    "jsEngine":"hermes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/main-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "updates": {
      "enabled": false
    },
    "splash": {
      "image": "./assets/main-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/favicon512.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE"
      ],
      "softwareKeyboardLayoutMode": "pan",
      "edgeToEdgeEnabled": false,
      "package": "com.yeganeh0.farimod2"
    },
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "favicon": "./assets/main-icon.png"
    },
    "extra": {
      "apiUrl": "http://my.farimod.ir",
      "eas": {
        "projectId": "3ee5b6c6-5afd-4598-bec5-e42be3262d50"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "networkSecurityConfig": "./network_security_config.xml"
          }
        }
      ],
      "expo-font",
      "expo-video",
      "@react-native-community/datetimepicker"
    ]
  }
}
