{
  "expo": {
    "name": "farimod",
    "slug": "farimod-2",
    "jsEngine": "hermes",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/main-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "updates": {
      "enabled": false,
      "url": "https://u.expo.dev/a213af95-269d-4b1e-beb1-91dda1de2d7c"
    },
    "splash": {
      "image": "./assets/main-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/favicon512.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE"
      ],
      "softwareKeyboardLayoutMode": "pan",
      "edgeToEdgeEnabled": false,
      "package": "com.yeganeh0.farimod2"
    },
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "favicon": "./assets/main-icon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "networkSecurityConfig": "./network_security_config.xml"
          }
        }
      ],
      "expo-font",
      "expo-video",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "a213af95-269d-4b1e-beb1-91dda1de2d7c"
      }
    },
    "owner": "sajad007",
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
